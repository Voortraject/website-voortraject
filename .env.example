# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.
# All VITE_-prefixed vars are PUBLIC — they are bundled into the browser build.
# Never put a Supabase service_role key (or any real secret) in a VITE_ variable.
#
# These belong to the website's OWN Supabase project (ref: zvsmazjcfzjyvnjrlnma).
# The external CRM Supabase connection is configured separately in
# src/integrations/supabase/external-client.ts.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-publishable-anon-key"

# Publieke Google-reviewpagina (voor de "Alle reviews op Google"-knop op de home).
# Dit is GEEN secret — het is een openbare URL. Zonder deze var verschijnt de knop niet.
# Formaat: https://search.google.com/local/reviews?placeid=YOUR_PLACE_ID
VITE_GOOGLE_REVIEWS_URL=""

# Subsidiecheck — edge functions in het CRM-project (lfelnfukbrxznkevnevr).
# Beide zijn publieke function-URLs (GEEN secret). Zonder deze vars draait de
# subsidiecheck lokaal via de Vite-dev-proxy `/esw` en schrijft "Mail mij dit
# overzicht" alleen een lead (geen automatische mail).
#
# Databrug (serverside ophalen/parsen/verrijken/cachen van de Energiesubsidiewijzer):
#   https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/subsidiecheck
VITE_SUBSIDIECHECK_URL=""
# "Mail mij dit overzicht" (schrijft de lead + stuurt de mail via Resend):
#   https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/subsidiecheck-mail
VITE_SUBSIDIECHECK_MAIL_URL=""
