# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.
# All VITE_-prefixed vars are PUBLIC — they are bundled into the browser build.
# Never put a Supabase service_role key (or any real secret) in a VITE_ variable.
#
# These belong to the website's OWN Supabase project (ref: zvsmazjcfzjyvnjrlnma).
# The external CRM Supabase connection is configured separately in
# src/integrations/supabase/external-client.ts.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-publishable-anon-key"
