# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.
# All VITE_-prefixed vars are PUBLIC — they are bundled into the browser build.
# Never put a Supabase service_role key (or any real secret) in a VITE_ variable.
#
# These belong to the website's OWN Supabase project (ref: zvsmazjcfzjyvnjrlnma).
# The external CRM Supabase connection is configured separately in
# src/integrations/supabase/external-client.ts.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-public-publishable-anon-key"

# Publieke Google-reviewpagina (voor de "Alle reviews op Google"-knop op de home).
# Dit is GEEN secret — het is een openbare URL. Zonder deze var verschijnt de knop niet.
# Formaat: https://search.google.com/local/reviews?placeid=YOUR_PLACE_ID
VITE_GOOGLE_REVIEWS_URL=""

# Subsidiecheck — edge functions in het CRM-project (lfelnfukbrxznkevnevr).
# Beide zijn publieke function-URLs (GEEN secret).
#
# Databrug (serverside ophalen/parsen/verrijken/cachen van de Energiesubsidiewijzer).
# AANGERADEN om ook lokaal te zetten: rechtstreeks scrapen via de Vite-dev-proxy
# `/esw` (de terugval als deze var leeg is) faalt intermitterend — de browser
# vuurt per check ~12 parallelle requests zonder cache af en de bron hapert daar
# geregeld op. De function heeft een 12u-cache en nette limieten. Bij een
# bronfout ziet de bezoeker nu een eerlijke foutmelding (geen voorbeelddata),
# dus een haperende proxy is lokaal meteen zichtbaar. Leeg laten is alleen
# handig om de bron/parser zelf te debuggen.
#   https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/subsidiecheck
VITE_SUBSIDIECHECK_URL=""
# "Mail mij dit overzicht" (schrijft de lead + stuurt de mail via Resend). Leeg =
# terugval op een directe lead-insert zónder automatische mail; lokaal meestal
# leeg laten, anders verstuurt elke test een echte mail en een echte lead.
#   https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/subsidiecheck-mail
VITE_SUBSIDIECHECK_MAIL_URL=""

# Woninginfo — energielabel via de edge function `woninginfo` (EP-Online, secret
# EP_ONLINE_API_KEY staat server-side). Publieke function-URL (GEEN secret).
# Zonder deze var werkt de luchtfoto lokaal gewoon (client-side), maar toont het
# woningpaneel geen energielabel.
#   https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/woninginfo
VITE_WONINGINFO_URL="https://lfelnfukbrxznkevnevr.supabase.co/functions/v1/woninginfo"
